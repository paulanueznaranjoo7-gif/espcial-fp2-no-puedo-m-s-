    print("Nueva agenda esperada:")
    print(
        "Data(Lucia, 12:00) <-> "
        "Web(Marta, 13:00)"
    )

    print("Nueva agenda obtenida:")
    print_schedule(second)


main()  
    
    
    
    
    
    
