    # =====================================

    print("\n--- SPLIT AFTER ---")

    schedule = ConferenceSchedule()

    split_talks = [
        Talk("Python", "Ana", 9, 60),
        Talk("AI", "Luis", 10, 45),
        Talk("Security", "Pedro", 11, 50),
        Talk("Data", "Lucia", 12, 40),
        Talk("Web", "Marta", 13, 60)
    ]

    for talk in split_talks:
        schedule.add_talk(talk)

    second = schedule.split_after("Security")

