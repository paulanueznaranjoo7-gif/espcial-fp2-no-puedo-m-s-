        "Security(Pedro, 10:00)"
    )

    print("Lista obtenida:")
    print_schedule(schedule)


    # =====================================
    # 3. REMOVE REPEATED SPEAKERS
    # =====================================

    print("\n--- REMOVE REPEATED SPEAKERS ---")

    schedule = ConferenceSchedule()

    repeated = [
        Talk("Python", "Ana", 9, 60),
        Talk("AI", "Luis", 10, 45),
        Talk("Java", "Ana", 11, 50),
        Talk("Networks", "Pedro", 12, 40),
