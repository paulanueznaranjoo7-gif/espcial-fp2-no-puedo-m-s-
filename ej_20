class Movie:
    def __init__(self, title, genre, duration, rating):
        self.title = title
        self.genre = genre
        self.duration = duration
        self.rating = rating

    def __str__(self):
        return f"{self.title} ({self.genre}) - {self.duration} min - {self.rating}"

    def __repr__(self):
        return self.__str__()


class StreamingProfile:

    _todos_perfiles = 0

    def __init__(self, username, age):
        self._username = username
        self._age = age
        self._watched = []
        
        
    @property
    def age(self):
        return self._age
    
    @age.setter
    def age(self, edad):
            
        if 0 < edad < 120:
            self._age = edad
            return self._age
        else:
            return self._age
    
    def watch(self, movie):
        
        
        for peli in self._watched:
            if movie.title == peli.title:
                return False
            
        self._watched.append(movie)
        StreamingProfile._todos_perfiles += 1
        return True
        
    
    def favorite_genre(self):

        generos = []
        mayor = 0
        genero = None
        for peli in self._watched:
            generos.append(peli.title)
            if generos.count(peli.genre) > mayor:
                mayor = generos.count(peli.title)
                genero = peli.genre
        return genero
    
    @classmethod 
    def total_views(cls):
        return cls._todos_perfiles
    
    @staticmethod 
    def recommended(movie, profile):
        
        if movie.genre == StreamingProfile.favorite_genre(profile) and movie.rating >= 7:
            return True
        else:
            return False
    
    def __str__(self):
        return f"{self._username} - {self._age}  {len(self._watched)} movies watched"
    

