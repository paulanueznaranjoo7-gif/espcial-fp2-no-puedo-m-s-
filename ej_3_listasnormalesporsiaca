class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

class Numbers:

    def __init__(self):
        self.numbers = []

    # ===========================
    # EJERCICIO 1
    #
    # Añade value SOLO si no existe
    #
    # Ejemplo:
    #
    # [5,3,8]
    #
    # add_unique(3)
    #
    # Resultado:
    #
    # [5,3,8]
    #
    # add_unique(10)
    #
    # Resultado:
    #
    # [5,3,8,10]
    # ===========================
    def add_unique(self, value):
        
        for i in self.numbers: #el for ya avanza or ti
            if i == value:
                return
        self.numbers.append(value)
        
        
    # ===========================
    # EJERCICIO 2
    #
    # Intercambia dos posiciones
    #
    # Ejemplo:
    #
    # [5,3,8,2]
    #
    # swap(1,3)
    #
    # Resultado:
    #
    # [5,2,8,3]
    # ===========================
    def swap(self, pos1, pos2):
        temp1 = self.numbers[pos1]
        temp2 = self.numbers[pos2]
        
        self.numbers[pos1] = temp2
        self.numbers[pos2] = temp1

    # ===========================
    # EJERCICIO 3
    #
    # Elimina TODOS los números
    # mayores que limit
    #
    # Ejemplo:
    #
    # [5,3,8,12,2]
    #
    # remove_greater_than(7)
    #
    # Resultado:
    #
    # [5,3,2]
    # ===========================
    def remove_greater_than(self, limit):
        if len(self.numbers) == 0:
            return None
        
        for i in self.numbers[:]:
            if i > limit:
                self.numbers.remove(i)

    def print_list(self):
        print(self.numbers)


# =====================
# MAIN
# =====================

lista = Numbers()

lista.numbers.append(5)
lista.numbers.append(3)
lista.numbers.append(8)
lista.numbers.append(12)
lista.numbers.append(2)

lista.print_list()

lista.add_unique(3)
lista.add_unique(20)
lista.print_list()

lista.swap(1, 4)
lista.print_list()

lista.remove_greater_than(7)
lista.print_list()
