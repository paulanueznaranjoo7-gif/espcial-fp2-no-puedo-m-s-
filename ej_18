class Student:
    def __init__(self, name, degree, grade, credits):
        self.name = name
        self.degree = degree
        self.grade = grade
        self.credits = credits

    def __str__(self):
        return f"{self.name} - {self.degree} - {self.grade} - {self.credits} credits"


class Node:
    def __init__(self, value, prev=None, next=None):
        self.value = value
        self.prev = prev
        self.next = next


class University:
    def __init__(self):
        self.first = None
        self.last = None

    def add_student(self, student):
        new_node = Node(student)

        if self.first is None:
            self.first = self.last = new_node
        else:
            self.last.next = new_node
            new_node.prev = self.last
            self.last = new_node
    
    @classmethod 
    def best_students(cls, students, minimum_grade):
        
        universidad = University()
        
        for estudiante in students:
            if estudiante.grade >= minimum_grade:
                universidad.add_student(estudiante)
        return universidad
    
    def credits_before(self, name):
        
        if self.first is None:
            return None
        elif self.first.value.name == name:
            return 0
        else:
            current = self.first
            creditos = 0
            
            while current is not None and current.value.name != name:
                creditos += current.value.credits
                current = current.next
            
            if current is None:
                return -1
            
            return creditos
            
    def replace_student(self, name, new_student):
        
        if self.first is None:
            return None
        else:
            current = self.first
            
            while current is not None:
                if current.value.name == name:
                    current.value.name = new_student
                    return True
                else:
                    current = current.next
            return -1
    
    @property
    def average_grade(self):
        
        if self.first is None:
            return None
        
        current = self.first
        suma = 0
        contador = 0
        while current is not None:
            suma += current.value.grade
            contador += 1
            current = current.next
        return suma / contador
    
    @average_grade.setter
    def average_grade(self, cantidad):
        
        if self.first is None:
            return None
        else:
            current = self.first
            suma = 0
            contador = 0
            while current is not None:
                suma += current.value.grade
                contador += 1
                current = current.next
            media = suma / contador
            
            resta = cantidad - media 
            
            current = self.first
            contar = 0
            suma = 0
            while current is not None:
                current.value.grade += resta
                valor = current.value.grade
                suma += valor
                contar += 1
                current = current.next
            return suma / contar
    
    def closest_grades(self):
        
        if self.first is None:
            return None
        else:
            prev = self.first
            current = self.first.next
            minimo = 10000
            mini = None
            while current is not None:
                resta = abs(prev.value.grade  - current.value.grade)
                if resta < minimo:
                    minimo = resta
                    mini = (prev.value.name, current.value.name)
                prev = current
                current = current.next
            return mini


def print_university(university):
    current = university.first

    while current is not None:
        print(
            f"{current.value.name}"
            f"({current.value.degree}, "
            f"nota={current.value.grade}, "
            f"créditos={current.value.credits})",
            end=""
        )

        if current.next is not None:
            print(" <-> ", end="")

        current = current.next

    print()


