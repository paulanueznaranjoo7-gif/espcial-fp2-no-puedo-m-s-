class Pet:

    def __init__(self, name, species, priority):
        self.name = name
        self.species = species
        self.priority = priority

    def __str__(self):
        return f"{self.name} ({self.species}) - priority {self.priority}"

    def __repr__(self):
        return self.__str__()


class Node:

    def __init__(self, pet):
        self.value = pet
        self.next = None
        self.prev = None


class VeterinaryClinic:

    clinic_name = "Happy Pets"

    def __init__(self):
        self.first = None
        self.last = None
        self._max_priority = 5
    
    @property
    def max_priority(self):
        return self._max_priority
    
    @max_priority.setter
    def max_priority(self, prioridad):
        if 0 < prioridad < 10:
            self._max_priority = prioridad
            return self._max_priority
        else:
            return self._max_priority
    
    @classmethod 
    def rename_clinic(cls, new_name):
        clinica = cls.clinic_name
        cls.clinic_name = new_name
        return clinica

    def insert_by_priority(self, pet):
        
        new_node = Node(pet)
        
        if self.first is None:
            self.first = self.last = new_node
            return True
        elif self.first.next is None:
            if pet.priority < self.first.value.priority:
                self.first.next = new_node
                new_node.prev = self.first
                return True
            else:
                new_node.next = self.first
                self.first.prev = new_node
                self.first = new_node
                return True
        else:
            prev = self.first
            current = self.first
            
            while current is not None and current.value.priority >= pet.priority:
                prev = current
                current = current.next
            animal = prev
            new_node.next = current
            animal.next = new_node 
            new_node.prev = animal
            if current is None:
                self.last = new_node
            else:
                current.prev = new_node
            return True
        return False
    
    def remove_species(self, species):
        
        if self.first is None:
            return None
        elif self.first.value.species == species:
            animal = self.first.value
            self.first = self.first.next
            return animal
        else:
            prev = self.first
            current = self.first.next
            
            while current is not None:
                if current.value.species == species:
                    animal = current.value
                    prev.next = current.next
                    if current.next is None:
                        self.last = prev
                    else:
                        current.next.prev = prev.next
                    return animal
                else:
                    prev = current
                    current = current.next

            return None
    
    def move_last_to_second(self):
        
        if self.first is None:
            return False
        elif self.first == self.last:
            return False
        elif self.first.next == self.last:
            return True
        else:
            animal = self.last
            self.last = self.last.prev
            prev = None
            current = self.first
            contador = 1
            
            while current is not None and contador < 2:
                prev = current
                current = current.next
                contador += 1
            if current is None and contador == 2:
                return False
            prev.next = animal
            animal.prev = prev
            animal.next = current
            current.prev = animal
            self.last.next = None
            return True
    
