class Guest:

    def __init__(self, name, room, nights):
        self.name = name
        self.room = room
        self.nights = nights

    def __str__(self):
        return f"{self.name} - room {self.room} - {self.nights} nights"

    def __repr__(self):
        return self.__str__()


class Node:

    def __init__(self, guest):
        self.value = guest
        self.next = None
        self.prev = None
    

class HotelFloor:
    def __init__(self, floor_number):
        self._floor_number = floor_number
        self._occupancy = 0
        self.first = None
        self.last = None
    
    @property
    def occupancy(self):
        return self._occupancy
    
    @staticmethod 
    def same_stay(guest1, guest2):
        
        if guest1.nights == guest2.nights:
            return True
        return False
    
    def insert_after_room(self, guest, room):
        
        new_node = Node(guest)
        
        if self.first is None:
            self.first = self.last = new_node
            self._occupancy += 1
            return True
        else:
            current = self.first
            
            while current is not None:
                if current.value.room == room:
                    siguiente = current.next
                    self._occupancy += 1
                    current.next = new_node
                    new_node.prev = current
                    new_node.next = siguiente
                    if siguiente is not None:
                        siguiente.prev = new_node
                    return True
                else:
                    current = current.next 
            return False
    
    def remove_every_second(self):
        
        if self.first is None:
            return None
        
        else:
            prev = self.first
            current = self.first.next
            contador = 0
            lista = []
            
            while current is not None:
                if contador % 2 == 0:
                    lista.append(current.value)
                    self._occupancy -= 1
                    prev.next = current.next
                    if current.next is None:
                        self.last = prev
                        return lista
                    else:
                        current.next.prev = prev
                    current = current.next
                    contador += 1
                else:
                    prev = current
                    current = current.next
                    contador += 1
            
            return lista  
    
    def split_at_room(self, room):
        
        new_hotelfloor = HotelFloor(self._floor_number)
        puntero = new_hotelfloor.first
        
        current = self.first
        nodo = None
        while current is not None:
            if current.value.room == room:
                nodo = current.next
                current.next = None
            else:
                current = current.next
                
        while nodo is not None:
            new = nodo
            if puntero is not None:
                new.next = new_hotelfloor.first
                new_hotelfloor.first.prev = new
                new_hotelfloor.first = new
            else:
                new_hotelfloor.first = new_hotelfloor.last = new
            nodo = nodo.next
        
        return 

