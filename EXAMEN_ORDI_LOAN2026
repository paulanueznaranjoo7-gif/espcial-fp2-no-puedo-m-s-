class Loan:
    def __init__(self, title, reader, days_overdue):
        self.title = title
        self.reader = reader
        self.days_overdue = days_overdue

    def __str__(self):
        return f"{self.title} ({self.reader}, {self.days_overdue}d)"

    def __repr__(self):
        return self.__str__()


class Node:
    def __init__(self, value):
        self.value = value
        self.next = None


class ContainerBase:
    def __init__(self):
        self.first = None
        self.last = None

    def __str__(self):
        result = ""
        current = self.first

        while current is not None:
            result += f"{current.value}->"
            current = current.next

        result += "None"
        return result
    
class LoanRegister(ContainerBase):
    def __init__(self, loans=None):
        super().__init__()
        self._penalties_collected = 0
        
        if loans is not None:
            for prestamo in loans:
                self.append_loan(prestamo)
        
    def append_loan(self, loan):
            
        new_node = Node(loan)
            
        if self.first is None:
            self.first = self.last = new_node
        else:
            self.last.next = new_node
            self.last = new_node
        
    def get_loans(self):
            
        lista = []
            
        current = self.first
            
        while current is not None:
            lista.append(current.value)
            current = current.next
            
        return lista
        
    def attend_return(self):
            
        if self.first is not None:
            eliminado = self.first
            self.first = self.first.next
            if self.first is None:
                self.last = None
                
            self._penalties_collected +=  eliminado.value.days_overdue * 2
            return eliminado.value
        else:
            return None
        
    @property
    def get_penalties_collected(self):
        return self._penalties_collected
        
    def get_overdue(self):
        
        retrasos = []
        current = self.first
            
        while current is not None:
            if current.value.days_overdue > 0:
                retrasos.append(current.value)
            current = current.next
            
        return retrasos
        
    def separate_overdue(self):
            
        prestamos = LoanRegister()
            
        while self.first is not None and self.first.value.days_overdue > 0:
                eliminado = self.first
                prestamos.append_loan(eliminado.value)
                self.first = self.first.next
            
        if self.first is None:
            return prestamos
        
        prev = self.first
        current = self.first.next
        
        while current is not None:
            if current.value.days_overdue > 0:
                eliminado = current
                prestamos.append_loan(eliminado.value)
                prev.next = current.next
                current = current.next
            else:
                prev = current
                current = current.next
        
        self.last = prev
        return prestamos

