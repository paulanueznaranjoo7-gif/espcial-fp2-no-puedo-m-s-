class Movie:
    def __init__(self, title, room, start_time, duration):
        self.title = title
        self.room = room
        self.start_time = start_time
        self.duration = duration

    def __str__(self):
        return f"{self.title} - sala {self.room} - {self.start_time}:00 - {self.duration} min"


class Node:
    def __init__(self, value, prev=None, next=None):
        self.value = value
        self.prev = prev
        self.next = next


class CinemaSchedule:
    def __init__(self):
        self.first = None
        self.last = None

    def add_movie(self, movie):
        new_node = Node(movie)

        if self.first is None:
            self.first = self.last = new_node
        else:
            self.last.next = new_node
            new_node.prev = self.last
            self.last = new_node
    
    @classmethod
    def from_room(cls, movies, room):

        cine = CinemaSchedule()

        for i in movies:
            if i.room == room:
                cine.add_movie(i)
        
        return cine
    
    def insert_before_time(self, movie, time):
        
        new_node = Node(movie)

        if self.first is None:
            return None
        elif self.first.value.start_time >= time:
            new_node.next = self.first
            self.first.prev = new_node
            return

        else:
            prev = self.first
            current = self.first.next

            while current is not None:
                if current.value.start_time >= time:
                    anterior = prev
                    nodo = current
                    new_node.next = current
                    current.prev = new_node
                    anterior.next = new_node
                    new_node.prev = anterior
                    return True
                else:
                    prev = current
                    current = current.next
            
            self.last.next = new_node
            new_node.prev = self.last
            self.last = new_node
    
    def total_between(self, title1, title2):

        if self.first is None:
            return None
        
        else:
            current = self.first
            while current is not None:
                if current.value.title == title2:
                    return -1
                elif current.value.title == title1:
                    duraciones = 0
                    while current.next.value.title != title2:
                        duraciones += current.next.value.duration
                        current = current.next
                    return duraciones
                else:
                    current = current.next
            
            return -1
    
    @property
    def last_room(self):
        if self.first is None:
            return None
        else:
            return self.last.value.room
    
    @last_room.setter
    def last_room(self, new_sala):

        if self.first is None:
            return None
        else:
            sala = self.last.value.room
            current = self.first

            while current is not None:
                if current.value.room == sala:
                    current.value.room = new_sala
                current = current.next
    
    def longest_gap(self):

        if self.first is None:
            return None
        else:
            prev = self.first
            current = self.first.next
            maximo = -99999
            max = None

            while current is not None:
                resta = (current.value.start_time - prev.value.start_time)
                if resta > maximo:
                    maximo = resta
                    max = prev.value.title, current.value.title
                prev = current
                current = current.next
            return max

          










def print_schedule(schedule):
    current = schedule.first

    while current is not None:
        print(
            f"{current.value.title}"
            f"(sala {current.value.room}, "
            f"{current.value.start_time}:00, "
            f"{current.value.duration} min)",
            end=""
        )

        if current.next is not None:
            print(" <-> ", end="")

        current = current.next

    print()


