lista = LinkedList()

lista.add_last(5)
lista.add_last(3)
lista.add_last(8)
lista.add_last(12)
lista.add_last(2)

print("Lista inicial:")
lista.print_list()

print(lista.contains(8))
print(lista.contains(20))

lista.insert_at(2, 100)
lista.print_list()

lista.remove_first_greater_than(7)
lista.print_list()
