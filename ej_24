class Car:

    def __init__(self, plate, owner, hours):
        self.plate = plate
        self.owner = owner
        self.hours = hours

    def __str__(self):
        return f"{self.plate} - {self.owner} - {self.hours} hours"

    def __repr__(self):
        return self.__str__()


class Node:

    def __init__(self, car):
        self.value = car
        self.next = None
        self.prev = None
    
class ParkingLot:
    def __init__(self, name, max_hours):
        self._name = name
        self._max_hours = max_hours
        self.first = None
        self.last = None
    
        
    @property
    def max_hours(self):
        return self._max_hours
    
    @max_hours.setter
    def max_hours(self, hora):
    
        if hora <= 0:
            return self._max_hours
    
        current = self.first
    
        while current is not None:
            if current.value.hours > hora:
                return self._max_hours
        
            current = current.next
    
        self._max_hours = hora
        return self._max_hours
        
    
    def find_owner(self, owner):
        
        current = self.first
        lista = []
        
        while current is not None:
            if current.value.owner == owner:
                lista.append(current.value)
            current = current.next
        return lista
    
    def park_before_plate(self, car, plate):
        
        new_node = Node(car)
        
        if self.first is None:
            self.first = self.last = new_node
            return True
        else:
            prev = None
            current = self.first
            
            while current is not None:
                if current.value.plate == plate:
                    if prev is None:
                        new_node.prev = None
                        self.first = new_node
                    elif prev is not None:
                        prev.next = new_node
                        new_node.prev = prev
                        
                    new_node.next = current
                    current.prev = new_node
                    return True
                else:
                    prev = current
                    current = current.next
            
            return False
    
    def remove_longest_stay(self):
        
        if self.first is None:
            return None
        elif self.first.next is None:
            eliminado = self.first
            self.first = self.first.next
            if self.first is None:
                self.last = None
            return eliminado
        
        current = self.first
        maximo = -99999
        maxi = None 
        
        while current is not None:
            if current.value.hours >= maximo:
                maximo = current.value.hours
                maxi = current.value
            current = current.next
        
        else:
            prev = self.first
            current = self.first.next
            
            if self.first.value == maxi:
                self.first = self.first.next
                return maxi
            
            while current is not None:
                if current.value  == maxi:
                    prev.next = current.next
                    if current.next is None:
                        self.last = prev
                    else:
                        current.next.prev = prev
                    return maxi
                else:
                    prev = current
                    current = current.next
            return None
    
    @classmethod 
    def most_occupied(cls, parking1, parking2):
        
            puntero1 = parking1.first
            puntero2 = parking2.first
            
            contero1 = 0
            while puntero1 is not None:
                contero1 += 1
                puntero1 = puntero1.next
            
            contero2 = 0
            while puntero2 is not None:
                contero2 += 1
                puntero2 = puntero2.next
            
            if contero1 > contero2:
                return parking1
            elif contero2 > contero1:
                return parking2
            else:
                return None
                
